NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Server-only order notifications. The recipient must be your Resend account email
# while using the onboarding@resend.dev test sender. Never use NEXT_PUBLIC_ here.
RESEND_API_KEY=YOUR_RESEND_API_KEY
ORDER_NOTIFICATION_EMAIL=your-resend-account@example.com
# Optional integration checks only. Use synthetic accounts; never commit real values.
TEST_ADMIN_EMAIL=admin@example.test
TEST_ADMIN_PASSWORD=REPLACE_LOCALLY
TEST_OTHER_EMAIL=other@example.test
TEST_OTHER_PASSWORD=REPLACE_LOCALLY
